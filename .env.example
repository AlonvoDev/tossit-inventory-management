# Public P256 VAPID key. Must match WEB_PUSH_VAPID_PUBLIC_KEY in Functions.
VITE_VAPID_PUBLIC_KEY=REPLACE_WITH_GENERATED_PUBLIC_VAPID_KEY

# Neon callable base URL, e.g. https://<branch>-tossitapi.compute.<region>.aws.neon.tech/
# Leave unset only for the explicitly retained legacy Firebase/emulator adapter.
VITE_SERVER_API_URL=
