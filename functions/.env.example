# Public values, configured for the target Firebase project before deployment.
WEB_PUSH_VAPID_PUBLIC_KEY=REPLACE_WITH_GENERATED_PUBLIC_VAPID_KEY
WEB_PUSH_CONTACT=mailto:replace-with-owner@example.invalid
# WEB_PUSH_VAPID_PRIVATE_KEY belongs only in Neon runtime secrets (or Firebase Secret Manager for the legacy host).

# Neon server-only configuration; never include a real credential in this tracked example.
TOSSIT_FIREBASE_PROJECT_ID=tossit-4cc02
FIREBASE_SERVICE_ACCOUNT_JSON=
TOSSIT_ALLOWED_ORIGINS=https://tossit-inventory-management.onrender.com
# Set to the real disabled schedule trigger ID before enabling it.
TOSSIT_NEON_TRIGGER_ID=
